{
  "name": "e1-code",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental local AI workspace, multi-provider gateway, account routing, and desktop integration",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "dev": "node src/dev.cjs",
    "build": "node scripts/build.cjs",
    "postinstall": "node scripts/sync-ui-vendor.cjs",
    "dev:chat": "ASTER_PROTOTYPE=1 node src/dev.cjs",
