    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "dompurify": "^3.3.1",
    "marked": "^17.0.0",
    "node-pty": "1.2.0-beta.14"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maceoCK/e1-code.git"
  }
